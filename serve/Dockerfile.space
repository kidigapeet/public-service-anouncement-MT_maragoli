# Hugging Face Space image (Docker SDK, CPU Basic: 2 vCPU / 16 GB).
#
# Differences from the plain CPU Dockerfile, all of them required by Spaces:
#   - listens on 7860, the port Spaces exposes
#   - runs as uid 1000; the container is not root and $HOME must be writable
#   - HF_HOME points somewhere that user owns, or the model download fails
#   - serves ONE model, so a visitor waits seconds rather than a minute and the
#     cold start pulls 2.4 GB instead of 8
#
# A free Space loses its disk on restart, so the weights are re-downloaded after
# an idle period. That is the price of the free tier; it is a slow first request,
# not a broken one.
FROM python:3.11-slim

RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/home/user/.cache/huggingface \
    ENABLED_SYSTEMS=mixed \
    MAX_RESIDENT=1 \
    PRELOAD=1 \
    BEAMS=4 \
    PORT=7860

WORKDIR $HOME/app

# CPU wheels only - the CUDA build is ~2.5 GB of no use on this hardware.
RUN pip install --no-cache-dir --user \
        --index-url https://download.pytorch.org/whl/cpu "torch>=2.2,<3.0"

COPY --chown=user requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

COPY --chown=user app.py .
COPY --chown=user static ./static
COPY --chown=user metrics ./metrics

EXPOSE 7860
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "7860"]
