# Copy to .env and fill in. .env is gitignored - never commit a real token.
#
# A READ-scoped token is all this service needs. Generate one at
# https://huggingface.co/settings/tokens and give it read access to the three
# private repositories below. Do not use a write token: this process never
# uploads anything, and a leaked write token can delete your models.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model repositories. Change these if you rename anything on the Hub.
BASE_MODEL=facebook/nllb-200-distilled-600M
HF_STAGE1=samuelabrha/nllb-200-600M-ekegusii-stage1
HF_STAGE2=samuelabrha/nllb-200-600M-ekegusii-psa
HF_MIXED=samuelabrha/nllb-200-600M-ekegusii-mixed

# How many models stay in memory. 4 keeps every card instant.
MAX_RESIDENT=4
# Load everything at startup rather than on the first request, so the first
# visitor does not wait ~4 minutes for four downloads.
PRELOAD=1

# Beam width. 4 matches the evaluation in notebook 06, so a number in the paper
# and a string on screen came from identical settings. 1 is roughly twice as
# fast and noticeably worse - only worth it on a CPU-only host.
BEAMS=4
MAX_NEW_TOKENS=128

# Which systems to serve.
#   mixed                          -> public demo, one model  (default)
#   stock,stage1,stage2,mixed      -> internal four-way comparison
ENABLED_SYSTEMS=mixed

# Where corrections go: a Hugging Face DATASET repo you own. Leave it empty and
# feedback is written to the container's disk, which a Space wipes on restart.
FEEDBACK_REPO=

# Set to 1 to run the UI with no weights at all, for front-end work.
MOCK_MODE=0
