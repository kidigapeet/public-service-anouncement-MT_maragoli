# GPU image. Starts from a PyTorch runtime so CUDA, cuDNN and torch already
# match each other - building torch+CUDA by hand on top of a bare nvidia/cuda
# image is the usual way this goes wrong.
#
#   docker build -f Dockerfile.gpu -t ekegusii-ui:gpu .
#   docker run --gpus all -p 8000:8000 -e HF_TOKEN=hf_... -v hf-cache:/cache ekegusii-ui:gpu
FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/cache/huggingface

WORKDIR /app

COPY requirements.txt .
# torch is already in the base image; installing it again would swap the CUDA
# build for a CPU one.
RUN grep -v '^torch' requirements.txt > /tmp/req.txt \
 && pip install --no-cache-dir -r /tmp/req.txt

COPY app.py .
COPY static ./static
COPY metrics ./metrics

RUN mkdir -p /cache/huggingface

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=4).status==200 else 1)"

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
